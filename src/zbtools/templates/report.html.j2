<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Zoombinis decompilation progress</title>
<style>
  :root {
    --bg: #fbfaf8; --panel: #ffffff; --text: #1f1d1a; --muted: #6b665e; --border: #e4e0d8;
    --matched: #2f8f5b; --functional: #3f7fbf; --nonmatching: #d49a2a; --library: #7a8aa6; --todo: #e4e0d8;
    --diff: #fdeee0; --diff-text: #8a3b12; --code-bg: #f5f3ef;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #161513; --panel: #1f1e1b; --text: #ece8e1; --muted: #a39e95; --border: #34322e;
      --matched: #4fb57f; --functional: #6fa3db; --nonmatching: #e0b14f; --library: #8e9dba; --todo: #34322e;
      --diff: #3a2a1c; --diff-text: #f0b88c; --code-bg: #1a1917;
    }
  }
  * { box-sizing: border-box; }
  body { margin: 0; background: var(--bg); color: var(--text);
         font: 14px/1.5 -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; }
  main { max-width: 1400px; margin: 0 auto; padding: 32px 20px 64px; }
  h1 { font-size: 24px; margin: 0 0 4px; }
  h2 { font-size: 18px; margin: 40px 0 12px; }
  .muted { color: var(--muted); }
  code, pre, .mono { font-family: ui-monospace, "SF Mono", Menlo, Consolas, monospace; font-size: 12px; }
  .cards { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 12px; }
  .card { background: var(--panel); border: 1px solid var(--border); border-radius: 8px; padding: 14px 16px; }
  .card h3 { margin: 0 0 2px; font-size: 15px; text-transform: capitalize; }
  .bar { display: flex; height: 10px; border-radius: 5px; overflow: hidden; background: var(--todo); margin: 10px 0 8px; }
  .bar span { display: block; height: 100%; }
  .legend { display: flex; flex-wrap: wrap; gap: 4px 14px; font-size: 12px; color: var(--muted); }
  .dot { display: inline-block; width: 9px; height: 9px; border-radius: 50%; margin-right: 5px; vertical-align: -1px; }
  .s-matched { background: var(--matched); } .s-functional { background: var(--functional); } .s-nonmatching { background: var(--nonmatching); }
  .s-library { background: var(--library); } .s-todo { background: var(--todo); border: 1px solid var(--muted); }
  .fn { background: var(--panel); border: 1px solid var(--border); border-radius: 8px; margin: 16px 0; overflow: hidden; }
  .fn header { padding: 10px 16px; border-bottom: 1px solid var(--border); display: flex; flex-wrap: wrap; gap: 4px 16px; align-items: baseline; }
  .fn header strong { font-size: 15px; }
  .scroll { overflow-x: auto; }
  table.cmp { border-collapse: collapse; width: 100%; }
  table.cmp th { text-align: left; font-weight: 600; padding: 6px 10px; color: var(--muted); border-bottom: 1px solid var(--border); font-size: 12px; }
  table.cmp td { padding: 0 10px; vertical-align: top; white-space: pre; }
  table.cmp td.src { background: var(--code-bg); border-left: 1px solid var(--border); border-right: 1px solid var(--border); padding: 8px 12px; min-width: 320px; }
  table.cmp tr.diff td.asm { background: var(--diff); color: var(--diff-text); }
  td.asm .off { color: var(--muted); } td.asm .raw { color: var(--muted); } td.asm .note { color: var(--accent, #2a7ab0); }
  .error { padding: 10px 16px; color: var(--diff-text); background: var(--diff); white-space: pre-wrap; }
  .filters { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 10px; }
  .filters input, .filters select { background: var(--panel); color: var(--text); border: 1px solid var(--border); border-radius: 6px; padding: 6px 8px; font: inherit; }
  table.list { border-collapse: collapse; width: 100%; background: var(--panel); border: 1px solid var(--border); border-radius: 8px; overflow: hidden; }
  table.list th, table.list td { padding: 4px 10px; border-bottom: 1px solid var(--border); text-align: left; }
  table.list th { color: var(--muted); font-weight: 600; font-size: 12px; }
  table.list td.num { text-align: right; font-variant-numeric: tabular-nums; }
</style>
</head>
<body>
<main>
  <h1>Zoombinis decompilation progress</h1>
  <p class="muted">Generated {{ generated }} &middot; compiled with Borland C++ {{ release }} &middot; percentages are by bytes of code</p>

  <h2>By region</h2>
  <div class="cards">
    {% for s in stats if s.total.functions %}
    <div class="card">
      <h3>{{ s.region }}</h3>
      <div class="muted">{{ s.total.functions }} functions &middot; {{ (s.total.size / 1024) | round(1) }} KB</div>
      <div class="bar" title="matched {{ s.percent(Status.MATCHED) | round(1) }}%">
        {% for status in [Status.MATCHED, Status.FUNCTIONAL, Status.NONMATCHING, Status.LIBRARY] %}
        <span class="s-{{ status }}" style="width: {{ s.percent(status) }}%"></span>
        {% endfor %}
      </div>
      <div class="legend">
        {% for status in Status %}{% set t = s.by_status.get(status) %}{% if t %}
        <span><span class="dot s-{{ status }}"></span>{{ status }}: {{ t.functions }} ({{ s.percent(status) | round(1) }}%)</span>
        {% endif %}{% endfor %}
      </div>
    </div>
    {% endfor %}
  </div>

  <h2>By module</h2>
  <div class="scroll">
    <table class="list">
      <thead><tr><th>Module</th><th>Start</th><th class="num">Functions</th><th class="num">Bytes</th><th class="num">Done</th><th>Progress</th></tr></thead>
      <tbody>
      {% for m in module_stats %}
        <tr>
          <td class="mono">{{ m.name }}</td>
          <td class="mono">{{ '0x%08x' % m.start }}</td>
          <td class="num">{{ m.done.functions }} / {{ m.total.functions }}</td>
          <td class="num">{{ m.total.size }}</td>
          <td class="num">{{ m.percent | round(1) }}%</td>
          <td><div class="bar" style="min-width: 120px"><span class="s-matched" style="width: {{ m.percent }}%"></span></div></td>
        </tr>
      {% endfor %}
      </tbody>
    </table>
  </div>

  <h2>Decompiled functions ({{ details | length }})</h2>
  {% for d in details %}
  <section class="fn" id="fn-{{ '%x' % d.address }}">
    <header>
      <strong class="mono">{{ d.name }}</strong>
      <span class="mono muted">{{ '0x%08x' % d.address }}</span>
      <span><span class="dot s-{{ d.status }}"></span>{{ d.status }}</span>
      <span class="muted">{{ d.size }} bytes</span>
      {% if d.matching_percent is not none %}<span class="muted">{{ d.matching_percent | round(1) }}% of bytes match</span>{% endif %}
      <span class="muted mono">{{ d.source_file }}</span>
    </header>
    {% if d.error %}<div class="error mono">{{ d.error }}</div>{% endif %}
    <div class="scroll">
      <table class="cmp mono">
        <tr><th>Original</th><th>C++</th><th>Recompiled</th></tr>
        {% for row in d.rows %}
        <tr class="{{ '' if row.same else 'diff' }}">
          <td class="asm">{% if row.original %}<span class="off">{{ row.original.offset }}</span>  <span class="raw">{{ '%-21s' % row.original.raw }}</span> {{ row.original.text }}{% if row.original.note %}<span class="note">  ; {{ row.original.note }}</span>{% endif %}{% endif %}</td>
          {% if loop.first %}<td class="src" rowspan="{{ d.rows | length }}">{{ d.source }}</td>{% endif %}
          <td class="asm">{% if row.recompiled %}<span class="off">{{ row.recompiled.offset }}</span>  <span class="raw">{{ '%-21s' % row.recompiled.raw }}</span> {{ row.recompiled.text }}{% if row.recompiled.note %}<span class="note">  ; {{ row.recompiled.note }}</span>{% endif %}{% endif %}</td>
        </tr>
        {% else %}
        <tr><td></td><td class="src">{{ d.source }}</td><td></td></tr>
        {% endfor %}
      </table>
    </div>
  </section>
  {% endfor %}

  <h2>All functions ({{ functions | length }})</h2>
  <div class="filters">
    <input id="q" type="search" placeholder="Filter by name or address">
    <select id="region"><option value="">All regions</option>{% for r in stats if r.total.functions %}<option>{{ r.region }}</option>{% endfor %}</select>
    <select id="status"><option value="">All statuses</option>{% for s in Status %}<option>{{ s }}</option>{% endfor %}</select>
  </div>
  <div class="scroll">
    <table class="list" id="functions">
      <thead><tr><th>Address</th><th>Name</th><th>Module</th><th>Region</th><th>Status</th><th class="num">Bytes</th><th class="num">Calls</th></tr></thead>
      <tbody>
      {% for f in functions %}
        <tr data-region="{{ f.region }}" data-status="{{ f.status }}">
          <td class="mono">{% if f.decompiled %}<a href="#fn-{{ '%x' % f.address }}">{{ '0x%08x' % f.address }}</a>{% else %}{{ '0x%08x' % f.address }}{% endif %}</td>
          <td class="mono">{{ f.name }}</td>
          <td class="mono">{{ f.module or '' }}</td>
          <td>{{ f.region }}</td>
          <td><span class="dot s-{{ f.status }}"></span>{{ f.status }}</td>
          <td class="num">{{ f.size }}</td>
          <td class="num">{{ f.calls | length }}{% if f.indirect_calls %} + {{ f.indirect_calls }}{% endif %}</td>
        </tr>
      {% endfor %}
      </tbody>
    </table>
  </div>
</main>
<script>
  const q = document.getElementById("q"), region = document.getElementById("region"),
        status = document.getElementById("status"),
        rows = [...document.querySelectorAll("#functions tbody tr")];
  function filter() {
    const text = q.value.toLowerCase();
    for (const row of rows) {
      const show = (!text || row.textContent.toLowerCase().includes(text)) &&
        (!region.value || row.dataset.region === region.value) &&
        (!status.value || row.dataset.status === status.value);
      row.hidden = !show;
    }
  }
  for (const el of [q, region, status]) el.addEventListener("input", filter);
</script>
</body>
</html>
